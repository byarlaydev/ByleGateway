{
	auto_https off
	admin off
}
:{$PORT:8080} {
	request_body {
		max_size 100KB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Cache-Control no-store
	}
	@private path /admin /admin/* /health
	respond @private 404
	@payments path /v1/* /webhooks/mmpay
	handle @payments {
		reverse_proxy api.railway.internal:4000 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}
	handle {
		reverse_proxy web.railway.internal:3000 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}
}
