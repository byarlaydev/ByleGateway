{
  "name": "byle-gateway",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w apps/api' 'npm run dev -w apps/web'",
    "build": "npm run build --workspaces",
    "test": "npm run test -w apps/api && tsx --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces",
    "test:session": "node tests/session.cjs",
    "test:deployment": "node tests/deployment.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
